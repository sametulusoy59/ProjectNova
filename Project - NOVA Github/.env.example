# Copy to .env  (never commit real values)
DOMAIN=ornek.com                  # your domain, WITHOUT https://
SETUP_TOKEN=change-this-long-random-text   # one-time key for creating the first admin account
# Optional tuning (defaults are fine):
# ANALYTICS_RETENTION_DAYS=90      # also editable in the panel (Ayarlar)
# MAX_UPLOAD_MB=5
# SESSION_HOURS=12
# SESSION_IDLE_MIN=120
